#!/usr/bin/env bash

# Resolve the directory where this script is located
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$PROJECT_DIR"

echo "[OrangeRipper] Starting up from: $PROJECT_DIR"

# Check if virtual environment exists, create if missing
if [ ! -d "venv" ]; then
    echo "[OrangeRipper] Virtual environment not found. Creating one..."
    python3 -m venv venv
    if [ $? -ne 0 ]; then
        echo "[Error] Failed to create virtual environment. Ensure python3-venv is installed."
        exit 1
    fi
fi

# Activate virtual environment
source venv/bin/activate

# Ensure required packages are installed
if [ -f "requirements.txt" ]; then
    echo "[OrangeRipper] Checking dependencies..."
    pip install --upgrade pip > /dev/null 2>&1
    pip install -r requirements.txt > /dev/null 2>&1
fi

# Launch the application
echo "[OrangeRipper] Launching application..."
python3 main.py

# Deactivate venv upon exit
deactivate
